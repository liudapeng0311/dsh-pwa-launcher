{
  "name": "dsh-pwa-launcher",
  "version": "1.11.0",
  "private": true,
  "description": "把 DeepSeek Harness 变成桌面应用：桌面/开始菜单上的图标双击即静默拉起 dsh web 服务，再以浏览器应用窗口打开界面；会话标题右侧提供「重启 | 版本」胶囊（注册进 dsh 的会话头部槽），可一键重启、检查新版本并自助升级（停服务→安装→校验→重启，失败自动回滚）。Windows 专用。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:client": "node client/build.mjs",
    "test": "node client/build.mjs && node test/plugin-test.mjs && node test/host-route-test.mjs && node test/update-retry-test.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File test/update-detect-test.ps1",
    "test:plugin": "node test/plugin-test.mjs",
    "test:host": "node test/host-route-test.mjs",
    "test:retry": "node test/update-retry-test.mjs",
    "test:update": "powershell -NoProfile -ExecutionPolicy Bypass -File test/update-detect-test.ps1"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "llsix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liudapeng0311/dsh-pwa-launcher.git"
  },
  "homepage": "https://github.com/liudapeng0311/dsh-pwa-launcher#readme",
  "bugs": {
    "url": "https://github.com/liudapeng0311/dsh-pwa-launcher/issues"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "pwa-launcher",
    "shortcut",
    "windows",
    "pwa"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
